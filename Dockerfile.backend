# NVIDIA CUDA base for GPU-accelerated embeddings (RTX 3090)
FROM nvidia/cuda:12.3.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y python3.11 python3.11-dev python3-pip nodejs npm curl && \
    ln -sf /usr/bin/python3.11 /usr/bin/python3 && \
    ln -sf /usr/bin/python3.11 /usr/bin/python && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ /app/backend/
COPY gitnexus_bridge/ /app/gitnexus_bridge/

WORKDIR /app/backend

EXPOSE 8000

# 16 workers for Ryzen 9 5950X (32 threads); 2 per core is optimal for async I/O workloads
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "16", "--loop", "uvloop", "--http", "httptools"]
